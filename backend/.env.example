############################################
# 로컬 개발용 템플릿 (git에 실제 값 커밋 금지)
# cp .env.example .env  후 로컬에서만 채우세요.
#
# 운영 키는 AWS / Docker / GitHub Secrets / Jenkins 로만 주입합니다.
############################################

# Spring Boot 프로파일 (local | test | prod)
SPRING_PROFILES_ACTIVE=local

# 서버 포트
SERVER_PORT=8080

# [SECRET] PortOne V2 API Secret
# 관리자 콘솔 > 결제 연동 > 식별코드 · API Keys > V2 API
# PG사 Secret Key(test_sk_...) 사용 금지
PORTONE_API_SECRET=

# [PUBLIC] 브라우저 SDK용 식별값
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=

# 테스트 상품 정보
PAYMENT_TEST_ORDER_NAME=포트원 테스트 상품
PAYMENT_TEST_AMOUNT=1000
PAYMENT_TEST_CURRENCY=CURRENCY_KRW
PAYMENT_TEST_PAY_METHOD=CARD
PAYMENT_TEST_CUSTOMER_NAME=테스트구매자
PAYMENT_TEST_CUSTOMER_PHONE=01012345678
PAYMENT_TEST_CUSTOMER_EMAIL=test@example.com

PORTONE_API_BASE_URL=https://api.portone.io

# local/test=TEST, prod=LIVE (prod 프로파일이 LIVE로 강제)
PORTONE_ALLOWED_CHANNEL_TYPE=TEST

CORS_ALLOWED_ORIGINS=http://localhost:3000
